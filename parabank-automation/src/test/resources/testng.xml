<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank Automation Suite" parallel="classes" thread-count="2">

    <listeners>
        <listener class-name="com.parabank.listeners.TestListener"/>
    </listeners>

    <!-- Quick sanity check: run before every commit, smallest possible set -->
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.parabank.tests.LoginTest"/>
            <class name="com.parabank.tests.RegistrationTest"/>
            <class name="com.parabank.tests.AccountsOverviewTest"/>
            <class name="com.parabank.tests.TransferFundsTest"/>
            <class name="com.parabank.tests.BillPayTest"/>
        </classes>
    </test>

    <!-- Slightly broader check: run after smoke passes, before merging -->
    <test name="Sanity Tests">
        <groups>
            <run>
                <include name="sanity"/>
            </run>
        </groups>
        <classes>
            <class name="com.parabank.tests.LoginTest"/>
            <class name="com.parabank.tests.AccountsOverviewTest"/>
            <class name="com.parabank.tests.FindTransactionsTest"/>
        </classes>
    </test>

    <!-- Full regression: run nightly or before a release -->
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.parabank.tests.LoginTest"/>
            <class name="com.parabank.tests.RegistrationTest"/>
            <class name="com.parabank.tests.AccountsOverviewTest"/>
            <class name="com.parabank.tests.OpenNewAccountTest"/>
            <class name="com.parabank.tests.TransferFundsTest"/>
            <class name="com.parabank.tests.BillPayTest"/>
            <class name="com.parabank.tests.FindTransactionsTest"/>
        </classes>
    </test>

</suite>
